# Public URL of the site, used for share previews. Set to the vanity domain once it's live.
NEXT_PUBLIC_SITE_URL=https://ignoranceisbliss.ai

# When selection closes (ISO 8601, UTC). Default: end of Friday, November 13, 2026, US Eastern.
NEXT_PUBLIC_SELECTION_CLOSES_AT=2026-11-14T04:59:59Z

# Storage for submissions. Add "Upstash for Redis" from the Vercel Marketplace and these are set for you.
# Either pair works: KV_REST_API_URL/KV_REST_API_TOKEN or UPSTASH_REDIS_REST_URL/UPSTASH_REDIS_REST_TOKEN.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: also post every submission to a webhook (Slack incoming webhook, Zapier, Make).
SUBMISSION_WEBHOOK_URL=

# Required to download submissions as CSV from /api/export?key=...
ADMIN_KEY=

# Extra domains to decline, comma separated. These add to the built-in lists in lib/rules.ts.
BLOCK_VENDOR_DOMAINS=
BLOCK_PERSONAL_DOMAINS=

# Let search engines index the site. Leave unset to keep it covert.
ALLOW_INDEXING=
