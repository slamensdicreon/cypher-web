# Public URL of the site, used for share previews and the link in confirmation emails.
NEXT_PUBLIC_SITE_URL=https://ignoranceisbliss.ai

# When selection closes (ISO 8601, UTC). Default: end of Friday, November 13, 2026, US Eastern.
NEXT_PUBLIC_SELECTION_CLOSES_AT=2026-11-14T04:59:59Z

# Where submissions are stored: Neon Postgres. Add Neon from the Vercel Marketplace and this is set
# for you (POSTGRES_URL also works). The table is created on first use.
DATABASE_URL=

# Resend: the API key, and a sender on a domain verified in Resend. Resend's test sender
# (onboarding@resend.dev) only reaches the Resend account's owner.
RESEND_API_KEY=
EMAIL_FROM=Cypher <cypher@example.com>

# Who on the team is emailed for every company put forward: one address, or several separated by commas.
INTERNAL_EMAIL_TO=

# Optional: where replies to the confirmation email go. Unset, replies go to EMAIL_FROM.
EMAIL_REPLY_TO=

# Required to download submissions as CSV from /api/export?key=...
ADMIN_KEY=

# Extra domains to decline, comma separated. These add to the built-in lists in lib/rules.ts and lib/vendors.ts.
BLOCK_VENDOR_DOMAINS=
BLOCK_PERSONAL_DOMAINS=

# Let search engines index the site. Leave unset to keep it covert.
ALLOW_INDEXING=
